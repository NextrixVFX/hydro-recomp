// xorps / andps on one lane with a constant's bits (the sign / abs masks).
inline float asm_xor( float x, uint32_t bits )
{
    uint32_t u;
    std::memcpy( &u, &x, 4 );
    u ^= bits;
    std::memcpy( &x, &u, 4 );
    return x;
}

// Integer registers (asm2c's int32_t values): a dword moved through a
// register is a BIT copy whatever the field's type; a byte is a byte.
template < class T >
inline int32_t asm_bits( const T& v )
{
    if constexpr ( sizeof( T ) == 4 )
    {
        int32_t i;
        std::memcpy( &i, &v, 4 );
        return i;
    }
    else
        return static_cast< int32_t >( v );
}

template < class T >
inline void asm_set_bits( T& v, int32_t i )
{
    if constexpr ( sizeof( T ) == 4 )
        std::memcpy( &v, &i, 4 );
    else
        v = static_cast< T >( i );
}

// movd xmm, r32: the integer's bits in lane 0.
inline float asm_movd( int32_t i )
{
    float f;
    std::memcpy( &f, &i, 4 );
    return f;
}

// cvtdq2ps, one lane: the lane's bits read as an int32, converted.
inline float asm_cvtdq( float lane )
{
    int32_t i;
    std::memcpy( &i, &lane, 4 );
    return static_cast< float >( i );
}

// cvttss2si: truncation; out of range / NaN -> 0x80000000 (the SSE rule).
inline int32_t asm_cvtt( float x )
{
    return _mm_cvtt_ss2si( _mm_set_ss( x ) );
}
// xorps / andps between two registers, lane by lane.
inline float asm_xorv( float x, float y )
{
    uint32_t u, v;
    std::memcpy( &u, &x, 4 );
    std::memcpy( &v, &y, 4 );
    u ^= v;
    std::memcpy( &x, &u, 4 );
    return x;
}

inline float asm_andv( float x, float y )
{
    uint32_t u, v;
    std::memcpy( &u, &x, 4 );
    std::memcpy( &v, &y, 4 );
    u &= v;
    std::memcpy( &x, &u, 4 );
    return x;
}

inline float asm_and( float x, uint32_t bits )
{
    uint32_t u;
    std::memcpy( &u, &x, 4 );
    u &= bits;
    std::memcpy( &x, &u, 4 );
    return x;
}

// A float at a BYTE offset from a byte pointer (retail's [base + index +
// disp] through a container's begin pointer), loaded / stored as its bits.
inline float asm_ldf( const uint8_t* p, int32_t off )
{
    float f;
    std::memcpy( &f, p + off, 4 );
    return f;
}

inline void asm_stf( uint8_t* p, int32_t off, float f )
{
    std::memcpy( p + off, &f, 4 );
}

