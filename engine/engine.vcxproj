      <PreprocessorDefinitions>NDEBUG;_CONSOLE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <AdditionalIncludeDirectories>$(ProjectDir);$(HydroGoldenDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <LanguageStandard>stdcpplatest</LanguageStandard>
      <LanguageStandard_C>stdclatest</LanguageStandard_C>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup>
    <PostBuildEvent>
      <Command>if not exist "$(ProjectDir)..\hydro\impl\engine\$(Configuration)$(HydroFlavor)" mkdir "$(ProjectDir)..\hydro\impl\engine\$(Configuration)$(HydroFlavor)"
copy /Y "$(TargetPath)" "$(ProjectDir)..\hydro\impl\engine\$(Configuration)$(HydroFlavor)\engine.lib"
copy /Y "$(ProjectDir)impl\engine.hxx" "$(ProjectDir)..\hydro\impl\engine\engine.hxx"</Command>
